#!/data/data/com.termux/files/usr/bin/bash
# ================= etctermux 功能菜单 =================
# 输入 kali 打开本菜单
export PATH="$PREFIX/bin:$PATH"
ETC="$PREFIX/etc/etctermux"
VER=$(cat "$ETC/version" 2>/dev/null || echo "?")
SHARED_DIR="$HOME/storage/shared/termux_kali_etc"

install_pkgs() {
    local label="$1"; shift
    echo "==> 安装 [$label]..."
    for p in "$@"; do
        if apt-get install -y "$p" >/dev/null 2>&1; then
            echo "    ✓ $p"
        else
            echo "    ✗ $p (失败/跳过)"
        fi
    done
}

install_pip() {
    local label="$1"; shift
    echo "==> pip 安装 [$label]..."
    for p in "$@"; do
        if python -m pip install --break-system-packages --quiet "$p" 2>/dev/null; then
            echo "    ✓ pip: $p"
        else
            echo "    ✗ pip: $p (失败/跳过)"
        fi
    done
}

tools_menu() {
    while true; do
        echo
        echo "======== 安装安全测试工具 (etctermux) ========"
        echo "  1) 信息收集     (apt: nmap dnsutils whois traceroute | pip: theharvester sherlock sublist3r)"
        echo "  2) 漏洞扫描     (apt: dirb | pip: wfuzz)"
        echo "  3) Web 渗透     (pip: sqlmap xsstrike commix wafw00f)"
        echo "  4) 密码攻击     (apt: crunch | 说明: hydra/john 已从官方源下架)"
        echo "  5) 嗅探/代理    (apt: netcat-openbsd socat)"
        echo "  6) 取证分析     (apt: binwalk steghide exiftool)"
        echo "  7) 完整 Kali 环境 (proot-distro install kali，联网下载，含全部 Kali 工具)"
        echo "  8) 全部核心工具 (上面所有 apt 工具一键装完)"
        echo "  0) 返回上级菜单"
        printf "请选择: "
        read -r opt
        case "$opt" in
            1) install_pkgs "信息收集(apt)" nmap dnsutils whois traceroute; install_pip "信息收集(pip)" theharvester sherlock sublist3r ;;
            2) install_pkgs "漏洞扫描(apt)" dirb; install_pip "漏洞扫描(pip)" wfuzz ;;
            3) install_pip "Web 渗透(pip)" sqlmap xsstrike commix wafw00f ;;
            4) install_pkgs "密码攻击(apt)" crunch ;;
            5) install_pkgs "嗅探/代理(apt)" netcat-openbsd socat ;;
            6) install_pkgs "取证分析(apt)" binwalk steghide exiftool ;;
            7) echo "安装完整 Kali 环境（体积较大，需联网，请耐心等待）..."; apt-get install -y proot-distro >/dev/null 2>&1 && proot-distro install kali && echo "启动完整 Kali: proot-distro login kali" || echo "安装失败，请检查网络后重试" ;;
            8) install_pkgs "核心工具(apt)" nmap dnsutils whois traceroute dirb netcat-openbsd socat binwalk steghide exiftool crunch htop tmux ;;
            0) return ;;
            *) echo "无效选项" ;;
        esac
    done
}

sites_menu() {
    local sites=(
        "OWASP 官方(安全知识)" "https://owasp.org"
        "PortSwigger Web安全学院" "https://portswigger.net/web-security"
        "Hack The Box(靶场)" "https://www.hackthebox.com"
        "TryHackMe(靶场)" "https://tryhackme.com"
        "HackerOne(漏洞赏金)" "https://www.hackerone.com"
        "Bugcrowd(漏洞赏金)" "https://www.bugcrowd.com"
        "Vulhub(漏洞环境)" "https://vulhub.org"
        "DVWA 靶场(GitHub)" "https://github.com/digininja/DVWA"
        "PentesterLab(练习)" "https://pentesterlab.com"
        "漏洞盒子 Vulbox" "https://www.vulbox.com"
        "补天漏洞响应平台" "https://www.butian.net"
        "先知社区(阿里)" "https://xz.aliyun.com"
        "FreeBuf 安全媒体" "https://www.freebuf.com"
        "看雪论坛" "https://www.kanxue.com"
        "Seebug 漏洞文库" "https://paper.seebug.org"
        "嘶吼专业版" "https://www.4hou.com"
    )
    while true; do
        echo
        echo "======== 白帽学习 / 测试网站 (etctermux) ========"
        local i=1
        for ((j=0; j<${#sites[@]}; j+=2)); do
            echo "  $i) ${sites[$j]}"
            i=$((i+1))
        done
        echo "  0) 返回上级菜单"
        printf "请选择(将用浏览器打开): "
        read -r opt
        if [ "$opt" = "0" ]; then return; fi
        local idx=$(( (opt-1) * 2 ))
        if [ "$idx" -ge 0 ] && [ "$idx" -lt "${#sites[@]}" ]; then
            local url="${sites[$((idx+1))]}"
            echo "打开: $url"
            termux-open "$url" 2>/dev/null || am start -a android.intent.action.VIEW -d "$url" 2>/dev/null || echo "打开失败: $url"
        else
            echo "无效选项"
        fi
    done
}

storage_menu() {
    while true; do
        echo
        echo "======== 共享存储管理 (etctermux) ========"
        echo "  1) 授权并创建 /storage/emulated/0/termux_kali_etc"
        echo "  2) 查看目录内容"
        echo "  3) 显示当前版本信息"
        echo "  0) 返回上级菜单"
        printf "请选择: "
        read -r opt
        case "$opt" in
            1) termux-setup-storage >/dev/null 2>&1; sleep 1; mkdir -p "$SHARED_DIR" && echo "✓ $SHARED_DIR 就绪" || echo "✗ 未授权存储,请允许弹窗后重试" ;;
            2) ls -la "$SHARED_DIR" 2>/dev/null || echo "目录不存在,请先选择 1)" ;;
            3) echo "当前版本: v$VER | 存储: $SHARED_DIR" ;;
            0) return ;;
            *) echo "无效选项" ;;
        esac
    done
}

# 支持子命令: kali mirror|tools|update|sites|sudo|about（供左侧抽屉/快捷调用）
case "$1" in
    mirror) bash "$ETC/mirror"; exit 0 ;;
    tools) tools_menu; exit 0 ;;
    update) bash "$ETC/etcupdate"; exit 0 ;;
    sites) sites_menu; exit 0 ;;
    sudo) bash "$ETC/sudo" /bin/bash; exit 0 ;;
    about) echo "开发者: etc | 版本: v$VER | 官网: https://etc.tw.kg | 联系: 2416444244@qq.com"; echo "仅限授权环境下的安全测试与学习"; exit 0 ;;
esac

while true; do
    echo
    echo "=========== etctermux v$VER ==========="
    echo "  1) 安装安全测试工具（分类）"
    echo "  2) 切换镜像源（清华/中科大/阿里云等）"
    echo "  3) 检查更新并安装新版"
    echo "  4) 打开白帽学习/测试网站"
    echo "  5) sudo 模拟 root（设备未 root 也可用）"
    echo "  6) 共享存储管理（termux_kali_etc）"
    echo "  7) 关于/帮助"
    echo "  0) 退出"
    printf "请选择: "
    read -r opt
    case "$opt" in
        1) tools_menu ;;
        2) bash "$ETC/mirror" ;;
        3) bash "$ETC/etcupdate" ;;
        4) sites_menu ;;
        5) bash "$ETC/sudo" /bin/bash ;;
        6) storage_menu ;;
        7) echo "开发者: etc | 版本: v$VER | 官网: https://etc.tw.kg | 联系: 2416444244@qq.com"; echo "仅限授权环境下的安全测试与学习"; echo "输入 mirror / etcupdate 可直接调用对应功能" ;;
        0) break ;;
        *) echo "无效选项" ;;
    esac
done
