<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="3dp"
        android:layout_marginVertical="0dp"
        android:orientation="vertical">

        <androidx.drawerlayout.widget.DrawerLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@+id/terminal_toolbar_view_pager"
            android:layout_height="match_parent">

            <com.termux.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:defaultFocusHighlightEnabled="false"
                android:focusableInTouchMode="true"
                android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
                android:scrollbars="vertical"
                tools:ignore="UnusedAttribute" />

            <LinearLayout
                android:id="@+id/left_drawer"
                android:layout_width="240dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:choiceMode="singleChoice"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp"
                android:descendantFocusability="blocksDescendants"
                android:orientation="vertical"
                android:background="?attr/termuxActivityDrawerBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/settings_button"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_settings"
                        android:background="@null"
                        android:contentDescription="@string/action_open_settings"
                        app:tint="?attr/termuxActivityDrawerImageTint" />
                </LinearLayout>

                <ListView
                    android:id="@+id/terminal_sessions_list"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_gravity="top"
                    android:layout_weight="1"
                    android:choiceMode="singleChoice"
                    android:longClickable="true" />

                <!-- etctermux 功能面板 -->
                <LinearLayout
                    android:id="@+id/etctermux_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="4dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚡ etctermux 功能"
                        android:textSize="12sp"
                        android:padding="4dp"
                        android:textStyle="bold"
                        android:textColor="?attr/termuxActivityDrawerImageTint" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/etctermux_mirror_button"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="镜像源" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/etctermux_tools_button"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="工具菜单" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/etctermux_update_button"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="检查更新" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/etctermux_sites_button"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="白帽网站" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/etctermux_sudo_button"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="sudo" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/etctermux_about_button"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="关于" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/etctermux_distro_button"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="发行版" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/etctermux_backup_button"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="备份" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/etctermux_kali_button"
                            style="?android:attr/buttonBarButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="kali" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toggle_keyboard_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_toggle_soft_keyboard" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/new_session_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_new_session" />
                </LinearLayout>
            </LinearLayout>

            <!-- etctermux 右侧面板：AI 帮助 + 自定义配置 -->
            <LinearLayout
                android:id="@+id/right_drawer"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="vertical"
                android:background="#FF111111"
                android:padding="10dp"
                android:descendantFocusability="blocksDescendants">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚙ etctermux 控制台"
                    android:textSize="15sp"
                    android:padding="6dp"
                    android:textStyle="bold"
                    android:textColor="#00E676" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI 帮助（OpenAI 兼容接口，可填 DeepSeek / 本地 Ollama 等）"
                    android:textSize="11sp"
                    android:padding="4dp"
                    android:textColor="#FFAAAAAA" />

                <EditText
                    android:id="@+id/ai_base_url"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="textUri"
                    android:hint="接口地址，如 https://api.openai.com/v1/chat/completions"
                    android:textSize="11sp"
                    android:background="#FF222222"
                    android:padding="6dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#FF888888" />

                <EditText
                    android:id="@+id/ai_api_key"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="textPassword"
                    android:hint="API Key（保存在本机）"
                    android:textSize="11sp"
                    android:background="#FF222222"
                    android:padding="6dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#FF888888" />

                <EditText
                    android:id="@+id/ai_model"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:inputType="text"
                    android:hint="模型，如 gpt-3.5-turbo / deepseek-chat"
                    android:textSize="11sp"
                    android:background="#FF222222"
                    android:padding="6dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#FF888888" />

                <EditText
                    android:id="@+id/ai_input"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:inputType="textMultiLine"
                    android:hint="输入问题，回车发送…"
                    android:textSize="12sp"
                    android:background="#FF222222"
                    android:padding="6dp"
                    android:textColor="#FFFFFFFF"
                    android:textColorHint="#FF888888" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ai_send_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="发送" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ai_save_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="保存配置" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp"
                    android:background="#FF1A1A1A">

                    <TextView
                        android:id="@+id/ai_reply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AI 回复将显示在这里。\n\n说明：AI 帮助需自行填写接口地址与 Key（支持任何 OpenAI 兼容端点），数据仅在本机与你的接口之间传输。"
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:textColor="#FFDDDDDD" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/right_new_session_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="新建会话" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/right_settings_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="设置" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/right_about_button"
                        style="?android:attr/buttonBarButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="关于" />
                </LinearLayout>

                <TextView
                    android:id="@+id/right_version_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="etctermux · 标识 com.termux.etc · v1.4.0"
                    android:textSize="10sp"
                    android:padding="4dp"
                    android:textColor="#FF777777" />
            </LinearLayout>

        </androidx.drawerlayout.widget.DrawerLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/terminal_toolbar_view_pager"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:background="@color/black"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent" />

</com.termux.app.terminal.TermuxActivityRootView>
